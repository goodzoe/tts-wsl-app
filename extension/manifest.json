{
  "manifest_version": 3,
  "name": "Brave TTS Reader (LatAm)",
  "version": "1.0",
  "description": "Lector de novelas WTR-Lab con motor local TTS Zero-Shot.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://wtr-lab.com/*", "http://127.0.0.1:8000/*"],
  "content_scripts": [
    {
      "matches": ["https://wtr-lab.com/*/novel/*/chapter-*"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ]
}

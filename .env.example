# ============================================================================
# Studio TTS LatAm — Configuración de Entorno (.env.example)
# Copia este archivo a .env si deseas personalizar puertos, rutas o hilos.
# ============================================================================

# Host y Puerto del Servidor Backend FastAPI
TTS_BACKEND_HOST=0.0.0.0
TTS_BACKEND_PORT=8000

# Hilos de CPU por defecto (si no se especifica, usa hasta 6 hilos automáticamente)
OMP_NUM_THREADS=6
MKL_NUM_THREADS=6
OPENBLAS_NUM_THREADS=6

# Modelo cargado automáticamente al iniciar el servidor
# Opciones: omnivoice-zeroshot-0.6b | canopy-es-multivoz-q4 | canopy-es-ultralight-q2 | orpheus-es-conversacional-q4
TTS_DEFAULT_MODEL=omnivoice-zeroshot-0.6b
